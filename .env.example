# Noctis AI Assistant Configuration Template
# Copy this file to '.env' and fill in your options.

# -----------------------------------------------------------------------------
# Required: Groq Cloud API Key for free high-speed Speech-to-Text & LLM
# Get your free key at: https://console.groq.com/keys
# -----------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here

# -----------------------------------------------------------------------------
# Optional: Customizable Identity & Host Configuration
# -----------------------------------------------------------------------------
# Assistant Owner Name (default: Master)
OWNER_NAME=Master

# Custom AI Assistant Name (default: Noctis)
NOCTIS_NAME=Noctis

# -----------------------------------------------------------------------------
# Optional: Personal Server Integrations (Leave empty for standalone local mode)
# -----------------------------------------------------------------------------
# Remote Memory Server IP / Host (leave empty to use local SQLite database)
MEMORY_SERVER_IP=

# Local Ollama Host (leave empty to use high-speed Groq Cloud API)
OLLAMA_HOST=
